package _1_Loops;

public class ForLoopUnderstanding {

	public static void main(String[] args)
	{
		// display 4 to 9 numbers vertically
		for(int i=4; i<=9; i++)
		{
			System.out.println(i);
		}
		
		// display 4 to 9 numbers horizontally
		for(int i=4; i<=9; i++)
		{
			System.out.print(i + " ");
		}
		System.out.println();
		
		
		// display 9 to 4 numbers horizontally
		for(int i=9; i>=4; i--)
		{
			System.out.print(i + " ");
		}
		System.out.println();
		
		//display A, a using type casting
		System.out.println((char)65);
		System.out.println((char)97);
		
		//display A B C D ----> ASCII of A is 65 and D is 68
		for(int i=65; i<=68; i++)
		{
			System.out.print(i+ " ");
		}
		
		
	}

}
