package com.tejas.specifications;

import org.springframework.data.jpa.domain.Specification;

import com.tejas.entities.Category;
import com.tejas.entities.Product;
import com.tejas.entities.SubCategory;

import jakarta.persistence.criteria.Join;

public class ProductSpecification 
{
	
	public static Specification<Product> hasSubCategoryName(String subCategoryName)
	{
		return (root, query, criteriaBuilder) -> 
		{
			if(subCategoryName==null || subCategoryName.isBlank())
			{
				return null;
			}
			
			Join<Product, SubCategory> productSubCatgoryJoin =	root.join("subCategory");
			//root.get("name") ---> pointing towards name column of root (Product)
			//productSubCatgoryJoin.get("name") --> pointing towards name column of subcategory
			//return criteriaBuilder.equal(productSubCatgoryJoin.get("name"), subCategoryName);
			 
			 return criteriaBuilder.equal(criteriaBuilder.lower(productSubCatgoryJoin.get("name")), subCategoryName.toLowerCase());
		};
	
	}
	
	public static Specification<Product> hasCategoryName(String categoryName)
	{
		
		return (root, query, criteriaBuilder) -> 
		{
			if(categoryName==null || categoryName.isBlank())
			{
				return null;
			}
			
			Join<Product, SubCategory> productSubCatgoryJoin =	root.join("subCategory");
			Join<SubCategory, Category> productSubCategoryCategoryJoin=productSubCatgoryJoin.join("category");
			//root.get("name") ---> pointing towards name column of root (Product)
			//productSubCategoryCategoryJoin.get("name") --> pointing towards name column of category
			
			//return criteriaBuilder.equal(productSubCatgoryJoin.get("name"), subCategoryName);
			 
			 return criteriaBuilder.equal(criteriaBuilder.lower(productSubCategoryCategoryJoin.get("name")), categoryName.toLowerCase());
		};
	
	}


	public static Specification<Product> sortPriceBy(String sortDirection)
	{
		
		return (root, query, criteriaBuilder) -> 
		{
			if(sortDirection==null || sortDirection.isBlank())
			{
				return null;
			}
			
			if(sortDirection.equalsIgnoreCase("asc"))
			{
				query.orderBy(criteriaBuilder.asc(root.get("price")));
			}
			else
			{
				query.orderBy(criteriaBuilder.desc(root.get("price")));
			}
			 
			 return null;
		};
	
	}

}

